    },
    "100": {
      "shouldTranslate": false
    },
    "20・40・60・80・100% のボタン": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons for 20, 40, 60, 80, and 100%"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "20・40・60・80・100% のボタン"
          }
        }
      }
    },
    "Mac にログインすると、自動でメニューバーに常駐します": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts in the menu bar when you log in to your Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac にログインすると、自動でメニューバーに常駐します"
          }
        }
      }
    },
