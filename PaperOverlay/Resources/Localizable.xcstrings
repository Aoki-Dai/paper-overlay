      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended strength"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめの強さ"
          }
        }
      }
    },
    "おすすめを表示": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show recommendations"
          }
        },
        "ja": {
          "stringUnit": {
