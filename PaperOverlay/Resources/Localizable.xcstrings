          "stringUnit": {
            "state": "translated",
            "value": "Use recommended"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめ設定にする"
          }
        }
      }
    },
    "このモニターだけ、下のスタイルと強さを使います": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This display uses the style and strength below"
