    "スタイル": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Style"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタイル"
          }
        }
